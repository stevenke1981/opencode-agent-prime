{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "preset": {
      "type": "string"
    },
    "disabled_agents": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "orchestrator",
          "explorer",
          "librarian",
          "oracle",
          "designer",
          "fixer"
        ]
      }
    },
    "locale": {
      "default": "zh-TW",
      "type": "string",
      "enum": ["zh-TW", "en"]
    },
    "lessons": {
      "default": {
        "enabled": true,
        "path": "lessons.md",
        "readAtSessionStart": true,
        "promptAfterIdle": true
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "path": {
          "default": "lessons.md",
          "type": "string"
        },
        "readAtSessionStart": {
          "default": true,
          "type": "boolean"
        },
        "promptAfterIdle": {
          "default": true,
          "type": "boolean"
        }
      }
    },
    "planMode": {
      "default": {
        "enabled": true,
        "plansDir": ".opencode/plans",
        "minComplexity": "L3"
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "plansDir": {
          "default": ".opencode/plans",
          "type": "string"
        },
        "minComplexity": {
          "default": "L3",
          "type": "string",
          "enum": ["L1", "L2", "L3", "L4"]
        }
      }
    },
    "memoryMcp": {
      "default": {
        "enabled": true,
        "serverName": "codebase-memory-mcp",
        "remindAtTaskStart": true
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "serverName": {
          "default": "codebase-memory-mcp",
          "type": "string"
        },
        "remindAtTaskStart": {
          "default": true,
          "type": "boolean"
        }
      }
    },
    "errorRecovery": {
      "default": {
        "enabled": true,
        "minAttemptsBeforeEscalate": 3
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "minAttemptsBeforeEscalate": {
          "default": 3,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "agents": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "variant": {
            "type": "string"
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mcps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "presets": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string"
            },
            "variant": {
              "type": "string"
            },
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "skills": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "mcps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "title": "opencode-agent-prime",
  "description": "Configuration schema for opencode-agent-prime OpenCode plugin"
}
